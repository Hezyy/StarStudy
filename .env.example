# 可选服务，全部留空时不影响本地应用。
OPENAI_API_KEY=
OPENAI_MODEL=
# 为本机AI网关设置单独的强访问口令；不要填写OpenAI密钥。
STAR_STUDY_AI_TOKEN=
# 只在本机开发时开启，生产环境自动禁用。
STAR_STUDY_LOCAL_IMPORT=0
# 仅公开publishable/anon key，绝不能使用service_role或sb_secret密钥。
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 通过 npm start 运行时读取；静态HTTPS部署使用构建时的NEXT_PUBLIC变量。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
HOST=127.0.0.1
PORT=3000
# 账号服务：留空DATABASE_URL继续使用原版离线本地模式。
DATABASE_URL=
# 至少32位随机值，Linux安装向导会自动生成；严禁NEXT_PUBLIC前缀。
SESSION_SECRET=
SETUP_TOKEN=
PUBLIC_URL=https://study.example.com
INITIAL_REGISTRATION=invite
# 仅回环地址测试时设1，公网HTTP不允许。
ALLOW_INSECURE_LOCAL=0
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
OPENAI_CHAT_MODEL=
AI_TIMEOUT_MS=45000
# 估算单价，单位为所选货币/百万tokens；留空时不提供费用估值。
AI_INPUT_PRICE_PER_MILLION=
AI_OUTPUT_PRICE_PER_MILLION=
# Docker安装脚本自动生成以下值；不要使用公开固定密码。
POSTGRES_PASSWORD=
SITE_ADDRESS=study.example.com
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
