{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "planId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[\\w.-]+$"
    },
    "planName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "startDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "endDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "timezone": {
      "type": "string",
      "const": "Asia/Shanghai"
    },
    "examTarget": {
      "type": "object",
      "properties": {
        "university": {
          "type": "string",
          "maxLength": 200
        },
        "major": {
          "type": "string",
          "maxLength": 200
        },
        "examDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "university",
        "major",
        "examDate"
      ],
      "additionalProperties": false
    },
    "subjects": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "externalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[\\w.-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "category": {
            "type": "string",
            "enum": [
              "math",
              "english",
              "cs",
              "politics",
              "custom"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "externalId",
          "name",
          "category",
          "priority"
        ],
        "additionalProperties": false
      }
    },
    "resources": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "externalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[\\w.-]+$"
          },
          "subjectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[\\w.-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "url": {
            "type": "string",
            "maxLength": 2000
          },
          "teacher": {
            "default": "",
            "type": "string",
            "maxLength": 200
          },
          "courseName": {
            "default": "",
            "type": "string",
            "maxLength": 300
          },
          "chapter": {
            "default": "",
            "type": "string",
            "maxLength": 300
          },
          "section": {
            "default": "",
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "externalId",
          "subjectId",
          "title",
          "url",
          "teacher",
          "courseName",
          "chapter",
          "section"
        ],
        "additionalProperties": false
      }
    },
    "knowledgePoints": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "externalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[\\w.-]+$"
          },
          "subjectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[\\w.-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "chapter": {
            "default": "",
            "type": "string",
            "maxLength": 300
          },
          "dependencyIds": {
            "default": [],
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[\\w.-]+$"
            }
          }
        },
        "required": [
          "externalId",
          "subjectId",
          "name",
          "chapter",
          "dependencyIds"
        ],
        "additionalProperties": false
      }
    },
    "tasks": {
      "minItems": 1,
      "maxItems": 20000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "externalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[\\w.-]+$"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "subjectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[\\w.-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "description": {
            "default": "",
            "type": "string",
            "maxLength": 20000
          },
          "estimatedMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 720
          },
          "taskType": {
            "type": "string",
            "enum": [
              "course",
              "exercise",
              "review",
              "exam",
              "reading",
              "other"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "knowledgePointIds": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[\\w.-]+$"
            }
          },
          "resourceIds": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[\\w.-]+$"
            }
          },
          "exerciseDescription": {
            "default": "",
            "type": "string",
            "maxLength": 2000
          },
          "notes": {
            "default": "",
            "type": "string",
            "maxLength": 20000
          }
        },
        "required": [
          "externalId",
          "date",
          "subjectId",
          "title",
          "description",
          "estimatedMinutes",
          "taskType",
          "priority",
          "knowledgePointIds",
          "resourceIds",
          "exerciseDescription",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "source": {
          "default": "",
          "type": "string",
          "maxLength": 200
        },
        "chunk": {
          "type": "string",
          "maxLength": 100
        },
        "notes": {
          "default": "",
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "source",
        "notes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "planId",
    "planName",
    "generatedAt",
    "startDate",
    "endDate",
    "timezone",
    "examTarget",
    "subjects",
    "resources",
    "knowledgePoints",
    "tasks",
    "metadata"
  ],
  "additionalProperties": false
}
