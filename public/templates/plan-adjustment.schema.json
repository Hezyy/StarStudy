{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "星研计划调整方案v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["app", "kind", "schemaVersion", "basePlanVersion", "reason", "changes"],
  "properties": {
    "app": { "const": "星研" },
    "kind": { "const": "plan-adjustment" },
    "schemaVersion": { "const": 1 },
    "basePlanVersion": { "type": "integer", "minimum": 0 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation", "taskId", "plan"],
            "properties": {
              "operation": { "const": "update" },
              "taskId": { "type": "string", "format": "uuid" },
              "plan": { "$ref": "#/$defs/plan" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation", "taskId", "plan"],
            "properties": {
              "operation": { "const": "create" },
              "taskId": { "type": "string", "format": "uuid" },
              "plan": {
                "allOf": [{ "$ref": "#/$defs/plan" }, { "required": ["title", "subjectId"] }]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation", "taskId"],
            "properties": {
              "operation": { "const": "archive" },
              "taskId": { "type": "string", "format": "uuid" }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "estimatedMinutes"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "estimatedMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "subjectId": { "type": "string", "format": "uuid" },
        "chapter": { "type": "string", "maxLength": 500 },
        "courseName": { "type": "string", "maxLength": 500 },
        "courseUrl": { "type": "string", "description": "空值或http/https URL，应用内再次校验" },
        "exercises": { "type": "string", "maxLength": 2000 },
        "knowledgePointIds": { "type": "array", "items": { "type": "string", "format": "uuid" } },
        "dependencyTaskIds": { "type": "array", "items": { "type": "string", "format": "uuid" } },
        "dueDate": { "type": "string", "format": "date" },
        "priority": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    }
  }
}
